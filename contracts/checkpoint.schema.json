{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:principalloop:checkpoint:0.1",
  "title": "PrincipalLoop checkpoint v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "worker_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "lease_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "plan_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "tasks_in_flight": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^\\S+$"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "effects_in_flight": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^\\S+$"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "quiescent": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifact_id",
          "sha256"
        ]
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "checkpoint_id",
    "project_id",
    "worker_run_id",
    "lease_id",
    "plan_epoch",
    "tasks_in_flight",
    "effects_in_flight",
    "quiescent",
    "artifacts",
    "created_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "quiescent": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "tasks_in_flight": {
            "maxItems": 0
          },
          "effects_in_flight": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
