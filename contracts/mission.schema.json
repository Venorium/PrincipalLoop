{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:principalloop:mission:0.1",
  "title": "PrincipalLoop mission v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "mission_revision": {
      "type": "integer",
      "minimum": 1
    },
    "goal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^\\S+$"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "hard_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^\\S+$"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "observable_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^\\S+$"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_tokens",
        "max_wall_seconds",
        "max_tool_calls"
      ]
    },
    "escalation_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "mission_revision",
    "goal_id",
    "objective",
    "acceptance_criteria",
    "scope",
    "hard_constraints",
    "allowed_actions",
    "observable_sources",
    "budget",
    "escalation_conditions"
  ]
}
