{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:principalloop:effect-intent:0.1",
  "title": "PrincipalLoop effect-intent v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "worker_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "lease_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "plan_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "resource_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S+$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "object_id",
          "revision",
          "sha256"
        ]
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "state": {
      "enum": [
        "INTENDED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "action_id",
    "project_id",
    "worker_run_id",
    "lease_id",
    "plan_epoch",
    "resource_id",
    "preconditions",
    "idempotency_key",
    "state",
    "created_at"
  ]
}
