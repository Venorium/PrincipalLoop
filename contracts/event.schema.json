{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:principalloop:event:0.1",
  "title": "PrincipalLoop event v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "event_type": {
      "enum": [
        "OBSERVATION",
        "TASK_PROGRESS",
        "CHECKPOINT_AVAILABLE",
        "RESULT_AVAILABLE"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "causal_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^\\S+$"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "reference_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S+$"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "summary",
        "reference_ids"
      ]
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "project_id",
    "event_type",
    "observed_at",
    "causal_ids",
    "payload"
  ]
}
