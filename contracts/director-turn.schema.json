{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:principalloop:director-turn:0.1",
  "title": "PrincipalLoop director-turn v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "turn_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "model_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "config_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "read_set": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S+$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "object_id",
          "revision",
          "sha256"
        ]
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "outcome": {
      "enum": [
        "NO_CHANGE",
        "PROPOSE"
      ]
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "urn:principalloop:decision-proposal:0.1"
        },
        {
          "type": "null"
        }
      ]
    },
    "doc_patch": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S+$"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "object_type": {
            "enum": [
              "HYPOTHESIS",
              "QUESTION",
              "OBSERVATION"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "status": {
            "enum": [
              "PROPOSED"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^\\S+$"
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "related_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^\\S+$"
            },
            "minItems": 0,
            "maxItems": 256,
            "uniqueItems": true
          }
        },
        "required": [
          "object_id",
          "expected_revision",
          "object_type",
          "statement",
          "status",
          "source_ids",
          "related_ids"
        ]
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "wall_ms"
      ]
    }
  },
  "required": [
    "schema_version",
    "turn_id",
    "project_id",
    "snapshot_id",
    "model_version",
    "prompt_version",
    "config_version",
    "read_set",
    "outcome",
    "proposal",
    "doc_patch",
    "cost"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "NO_CHANGE"
          }
        }
      },
      "then": {
        "properties": {
          "proposal": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "proposal": {
            "$ref": "urn:principalloop:decision-proposal:0.1"
          }
        }
      }
    }
  ]
}
