{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:principalloop:snapshot:0.1",
  "title": "PrincipalLoop snapshot v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "cut_event_seq": {
      "type": "integer",
      "minimum": 0
    },
    "mission_revision": {
      "type": "integer",
      "minimum": 1
    },
    "policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "plan_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "object_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S+$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "object_id",
          "revision",
          "sha256"
        ]
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "artifact_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifact_id",
          "sha256"
        ]
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "stability": {
      "enum": [
        "STABLE",
        "UNSTABLE"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "project_id",
    "cut_event_seq",
    "mission_revision",
    "policy_revision",
    "plan_epoch",
    "object_versions",
    "artifact_manifest",
    "stability",
    "created_at"
  ]
}
