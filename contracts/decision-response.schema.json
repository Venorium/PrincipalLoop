{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:principalloop:decision-response:0.1",
  "title": "PrincipalLoop DecisionResponse v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_run_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_decision_revision": {
      "type": "integer",
      "minimum": 1
    },
    "observed_plan_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "response": {
      "enum": [
        "ACCEPT",
        "DEFER",
        "CONTEST",
        "STALE"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "checkpoint_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "resume_trigger": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "defer_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "project_id",
    "decision_id",
    "worker_run_id",
    "expected_decision_revision",
    "observed_plan_epoch",
    "response",
    "reason",
    "evidence_ids",
    "checkpoint_id",
    "resume_trigger",
    "defer_until"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "response": {
            "const": "DEFER"
          }
        }
      },
      "then": {
        "properties": {
          "resume_trigger": {
            "type": "string",
            "minLength": 1
          },
          "defer_until": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}
